# Auto detect text files and perform LF normalization
* text=auto
# Asset manifests hash SVG bytes; keep checkouts identical on Windows and CI.
*.svg text eol=lf
**/tex_cottage_material_atlas_v001.png filter=lfs diff=lfs merge=lfs -text
**/tex_broadleaf_foliage_v001.png filter=lfs diff=lfs merge=lfs -text
