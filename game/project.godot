; Engine configuration file.
; Edit through the Godot editor when possible because not every setting is
; self-explanatory.
;
; Format:
;   [section]
;   param=value


config_version=5

[application]

config/name="Capybara"
run/main_scene="res://scenes/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputDeviceService="*res://autoload/input_device_service.gd"
SceneFlowService="*res://autoload/scene_flow_service.gd"
ContentRegistry="*res://autoload/content_registry.gd"
InventoryService="*res://autoload/inventory_service.gd"
SaveManager="*res://autoload/save_manager.gd"
SettingsService="*res://autoload/settings_service.gd"
AccessibilityService="*res://autoload/accessibility_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://localization/translations.en.translation", "res://localization/translations.zh_CN.translation")

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="WorldSolid"
2d_physics/layer_3="Interactable"
2d_physics/layer_4="NPC"
2d_physics/layer_5="ResourceNode"
2d_physics/layer_6="Water"
2d_physics/layer_7="PlacementBlocker"
2d_physics/layer_8="Trigger"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.105882, 0.137255, 0.145098, 1)
